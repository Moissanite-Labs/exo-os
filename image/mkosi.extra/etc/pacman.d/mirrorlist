# Exo OS: Arch's worldwide mirror (a CDN), then a second, independent mirror so one unreachable
# edge does not fail an install. Packages are signature-verified either way. Replace with nearer
# mirrors with reflector if wanted.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirrors.edge.kernel.org/archlinux/$repo/os/$arch
