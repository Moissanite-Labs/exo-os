[Unit]
Description=Exo OS: create the Exo store and machine profile if missing
ConditionUser=exo
Before=exod.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/exo/bin/exo-os-setup
Environment=EXO_LEDGER_AUTHORITY=exo-os
Environment=EXO_LEDGER_AUTHORITY_REQUIRED=1
Environment=EXO_MODEL_SPEND_REQUIRED=1
Environment=EXO_MODEL_SPEND_POLICY=/var/lib/exo/model-spend/policy.json

[Install]
WantedBy=default.target
