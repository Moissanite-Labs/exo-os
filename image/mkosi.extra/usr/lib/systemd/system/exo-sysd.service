[Unit]
Description=Exo OS system helper (named root actions only)
Requires=exo-sysd.socket
RequiresMountsFor=/var/lib/exo-sysd
AssertPathIsMountPoint=/var/lib/exo-sysd

[Service]
ExecStart=/opt/exo/bin/exo-sysd
StateDirectory=exo-sysd
StateDirectoryMode=0700
RuntimeDirectory=exo-sysd
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
