[Unit]
Description=Exo protected ledger append authority
Requires=exo-ledger.socket
Requires=exo-ledger-provision.service
After=exo-ledger-provision.service
RequiresMountsFor=/var/lib/exo-ledger
AssertPathIsMountPoint=/var/lib/exo-ledger

[Service]
User=exo-ledger
Group=exo-ledger
ExecStart=/opt/exo/bin/exo-ledgerd
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/exo-ledger/private
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
TasksMax=12
MemoryMax=128M
LimitNOFILE=64
LimitCORE=0
