enable NetworkManager.service
disable systemd-networkd.service
disable systemd-networkd-wait-online.service
enable systemd-timesyncd.service
enable snapper-cleanup.timer
disable snapper-timeline.timer
enable greetd.service
enable exo-sysd.socket
enable exo-egress.socket
enable exo-os-firstboot.service
enable exo-ledger-provision.service
enable exo-model-spend-provision.service
enable exo-ledger.socket
enable exo-os-pacman-init.service
