#!/bin/sh
# Test profile only: run a command as the person, inside their running desktop session.
U=$(id -u exo)
RUNTIME_DIR="/run/user/$U"
S=$(ls "$RUNTIME_DIR/hypr" 2>/dev/null | head -1)
W=""
for sock in "$RUNTIME_DIR"/wayland-*; do
  # The display socket Hyprland actually bound, not a hardcoded name.
  [ -e "$sock" ] && { W=${sock##*/}; break; }
done
exec runuser -u exo -- env XDG_RUNTIME_DIR="$RUNTIME_DIR" WAYLAND_DISPLAY="$W" HYPRLAND_INSTANCE_SIGNATURE="$S" \
  DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$U/bus" HOME=/home/exo USER=exo \
  EXO_HOME=/var/lib/exo/exo EXO_PRINCIPAL=exo EXO_PLUGIN_DIRS=/opt/exo/plugins \
  EXO_TOOL_EXECUTOR=exo-os EXO_TOOL_EXECUTOR_REQUIRED=1 \
  EXO_LEDGER_AUTHORITY=exo-os EXO_LEDGER_AUTHORITY_REQUIRED=1 "$@"
